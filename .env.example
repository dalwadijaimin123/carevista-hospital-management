# MongoDB Atlas or local MongoDB connection string
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=hospital_management

# Administrator credentials (keep these private)
ADMIN_EMAIL=admin@hospital.com
ADMIN_PASSWORD=Admin@123

# Session signing secret - change this for a deployed project
JWT_SECRET=change-this-secret-in-production

PORT=3000

# Password reset OTP email delivery (Resend: https://resend.com)
RESEND_API_KEY=re_your_resend_api_key

# Use a verified sender/domain for production. Resend's onboarding sender is suitable only for testing.
PASSWORD_RESET_FROM=CareVista Hospital <onboarding@resend.dev>
APP_BASE_URL=http://localhost:3000